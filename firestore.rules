rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users full access to their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to submit feature requests and bug reports
    match /feature_requests/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /bug_reports/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users access to any other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}